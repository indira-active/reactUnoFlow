{
  "name": "smooch-desk",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "autoprefixer": "7.1.6",
    "babel-core": "6.26.0",
    "babel-eslint": "7.2.3",
    "babel-jest": "25.1.0",
    "babel-loader": "9.0.0",
    "babel-preset-react-app": "^4.0.0",
    "babel-runtime": "6.26.0",
    "case-sensitive-paths-webpack-plugin": "2.1.1",
    "chalk": "1.1.3",
    "circular-json": "0.5.1",
    "clone": "2.1.1",
    "css-loader": "6.0.0",
    "dotenv": "4.0.0",
    "dotenv-expand": "4.0.1",
    "eslint": "8.15.0",
    "eslint-config-react-app": "^2.1.0",
    "eslint-loader": "1.9.0",
    "eslint-plugin-flowtype": "6.0.0",
    "eslint-plugin-import": "2.27.4",
    "eslint-plugin-jsx-a11y": "5.1.1",
    "eslint-plugin-react": "7.10.0",
    "extract-text-webpack-plugin": "3.0.2",
    "file-loader": "1.1.5",
    "firebase": "7.14.0",
    "firebase-messaging": "1.0.6",
    "fs-extra": "3.0.1",
    "html-webpack-plugin": "2.29.0",
    "jest": "27.2.4",
    "material-ui": "0.20.2",
    "material-ui-search-bar": "0.4.1",
    "moment": "2.20.1",
    "node-sass": "4.7.2",
    "object-assign": "4.1.1",
    "postcss-flexbugs-fixes": "3.2.0",
    "postcss-loader": "5.0.0",
    "promise": "8.0.1",
    "raf": "3.4.0",
    "react": "^16.5.0",
    "react-bootstrap": "1.0.0",
    "react-dev-utils": "^11.0.1",
    "react-dom": "^16.2.0",
    "react-redux": "6.0.0",
    "react-router-dom": "5.0.0",
    "redux": "4.0.0",
    "redux-thunk": "2.2.0",
    "sass-loader": "11.0.0",
    "socket.io-client": "2.0.4",
    "style-loader": "3.0.0",
    "sw-precache-webpack-plugin": "0.11.5",
    "url-loader": "0.6.2",
    "webpack": "5.0.0",
    "webpack-dev-server": "5.1.0",
    "webpack-manifest-plugin": "3.0.0",
    "whatwg-fetch": "2.0.3"
  },
  "scripts": {
    "starttest": "node scripts/build.js && firebase deploy --only hosting && node scripts/start.js",
    "start":"node scripts/start.js",
    "build": "node scripts/build.js",
    "testdeploy": "npm run build && firebase deploy --only hosting",
    "buildanddeploy": "node scripts/build.js && git add --all && git commit -m'building out'&& git push origin master && firebase deploy",
    "test": "node scripts/test.js --env=jsdom"
  },
  "proxy": "https://damp-plateau-11898.herokuapp.com/",
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,mjs}"
    ],
    "setupFiles": [
      "<rootDir>/config/polyfills.js"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,mjs}",
      "<rootDir>/src/**/?(*.)(spec|test).{js,jsx,mjs}"
    ],
    "testEnvironment": "node",
    "testURL": "http://localhost",
    "transform": {
      "^.+\\.(js|jsx|mjs)$": "<rootDir>/node_modules/babel-jest",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|mjs|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|mjs)$"
    ],
    "moduleNameMapper": {
      "^react-native$": "react-native-web"
    },
    "moduleFileExtensions": [
      "web.js",
      "mjs",
      "js",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ]
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  },
  "eslintConfig": {
    "extends": "react-app"
  }
}
